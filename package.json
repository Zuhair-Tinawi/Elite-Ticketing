{
  "name": "elite-ticketing",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Elite Ticketing - Event Ticketing Management System capstone project",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest run",
